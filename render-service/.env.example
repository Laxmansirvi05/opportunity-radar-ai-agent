# ---------------------------------------------------------------------------
# Opportunity Radar Rendering Service - environment configuration
# Copy this file to .env and adjust as needed. All values shown are defaults.
# ---------------------------------------------------------------------------

# HTTP server
PORT=3000
HOST=0.0.0.0

# Optional bearer token auth for POST /fetch. Leave blank to disable auth
# (fine behind an internal network / n8n on the same Docker network).
API_KEY=

# Browser
HEADLESS=true
# Proactively recycle the browser (only once no pages are active, so no
# in-flight request is ever interrupted) after it has served this many
# pages, to bound the slow memory growth long-running Chromium processes
# accumulate. Set to 0 to disable this trigger.
BROWSER_MAX_PAGES=500
# ...and/or after this many milliseconds since launch. Set to 0 to disable.
BROWSER_MAX_AGE_MS=14400000

# Concurrency / queue
# Max Chromium pages rendered simultaneously. Tune to available CPU/RAM.
MAX_CONCURRENCY=5
# Max requests allowed to wait in the queue before new ones are rejected
# with 503 QUEUE_FULL.
MAX_QUEUE_SIZE=200

# Timeouts (all in milliseconds)
NAVIGATION_TIMEOUT_MS=30000
NETWORK_IDLE_TIMEOUT_MS=8000
RENDER_EXTRA_WAIT_MS=500
# Overall wall-clock budget for a single /fetch request, covering queueing,
# all retry attempts and backoff delays.
REQUEST_TIMEOUT_MS=60000
# How long a request may sit in the queue before it fails fast.
QUEUE_WAIT_TIMEOUT_MS=45000

# Retry / exponential backoff
MAX_RETRIES=3
RETRY_BASE_DELAY_MS=1000
RETRY_MAX_DELAY_MS=10000

# Cloudflare "I'm Under Attack Mode" / managed challenge handling
CLOUDFLARE_MAX_WAIT_MS=15000
CLOUDFLARE_POLL_INTERVAL_MS=1000

# Resource blocking
# Comma-separated Playwright resourceTypes to abort. "stylesheet" is
# intentionally NOT in the default list - CSS is kept so pages render
# correctly.
BLOCKED_RESOURCE_TYPES=image,font,media
# Comma-separated hostname fragments to abort regardless of resource type
# (ad networks, analytics, session replay, error trackers, etc).
BLOCKED_DOMAINS=google-analytics.com,googletagmanager.com,doubleclick.net,facebook.net,connect.facebook.net,hotjar.com,segment.com,segment.io,mixpanel.com,amplitude.com,fullstory.com,intercom.io,crazyegg.com,optimizely.com,adnxs.com,adsrvr.org,taboola.com,outbrain.com,criteo.com,quantserve.com,scorecardresearch.com,newrelic.com,nr-data.net,sentry.io,bugsnag.com,googlesyndication.com,adservice.google.com

# Security
# Reject /fetch requests whose URL host is a literal loopback/private/
# link-local address (127.0.0.1, 169.254.169.254 cloud metadata, 10/8,
# 172.16/12, 192.168/16, etc) to prevent this service being used as an SSRF
# pivot into the internal network. Set to false only if you deliberately
# need to render internal targets.
BLOCK_PRIVATE_NETWORK_TARGETS=true

# Misc
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36
VIEWPORT_WIDTH=1366
VIEWPORT_HEIGHT=768
MAX_HTML_SIZE_BYTES=15728640
LOG_LEVEL=info
SHUTDOWN_TIMEOUT_MS=15000
