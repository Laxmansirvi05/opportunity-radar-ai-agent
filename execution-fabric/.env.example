# PostgreSQL — shared with Data Plane
PGHOST=localhost
PGPORT=5432
PGDATABASE=opportunity_radar
PGUSER=
PGPASSWORD=

# Redis — for token-bucket rate limiting (fail-open if unavailable)
REDIS_URL=redis://localhost:6379

# Render Service — HTML rendering
RENDER_SERVICE_URL=http://localhost:3100
RENDER_SERVICE_API_KEY=

# AI Gateway — LLM extraction
GATEWAY_URL=http://localhost:4000
GATEWAY_API_KEY=

# Execution Fabric tuning
EF_MAX_CONCURRENT_WORKERS=5
EF_WORKER_TIMEOUT_MS=120000
EF_RUN_TIMEOUT_MS=600000

# Circuit breaker
EF_CB_FAILURE_THRESHOLD=5
EF_CB_COOLDOWN_MS=60000

# Rate limiting (token bucket)
EF_RATE_LIMIT_REQUESTS=10
EF_RATE_LIMIT_WINDOW_MS=60000

# Retry policy
EF_MAX_RETRY_ATTEMPTS=3
EF_RETRY_BASE_DELAY_MS=1000

# Provider company slugs (comma-separated — leave empty to skip that provider)
GREENHOUSE_COMPANIES=
LEVER_COMPANIES=
ASHBY_COMPANIES=
