# =============================================================================
# Opportunity Radar — Master Environment Variable Reference
# =============================================================================
#
# This file documents EVERY environment variable used across ALL services.
# It is the single authoritative reference for configuration.
#
# USAGE:
#   - Copy the relevant section to each service's own .env file.
#   - Never commit real secrets. This file contains only documented placeholders.
#   - Variables marked [REQUIRED] have no safe default and must be set.
#   - Variables marked [OPTIONAL] have safe defaults noted inline.
#
# =============================================================================


# =============================================================================
# AI GATEWAY  (ai-gateway/.env)
# =============================================================================

# HTTP server
PORT=4000                                   # [OPTIONAL] Default: 4000

# Auth — shared secret that all callers must supply as X-Api-Key header
GATEWAY_API_KEY=                            # [REQUIRED]

# Timeouts (milliseconds)
GLOBAL_TIMEOUT_MS=75000                     # [OPTIONAL] Per-request wall-clock budget
PROVIDER_TIMEOUT_MS=25000                   # [OPTIONAL] Per-provider call budget
MAX_PROVIDER_RETRIES=1                      # [OPTIONAL] Retries per provider (0–3)

# Google Gemini
GEMINI_API_KEY=                             # [REQUIRED]
GEMINI_MODEL=gemini-2.5-flash               # [OPTIONAL]

# OpenRouter (OpenAI-compatible proxy)
OPENROUTER_API_KEY=                         # [REQUIRED]
OPENROUTER_MODEL=google/gemini-2.5-flash    # [OPTIONAL]

# Groq (OpenAI-compatible)
GROQ_API_KEY=                               # [REQUIRED]
GROQ_MODEL=llama-3.3-70b-versatile          # [OPTIONAL]


# =============================================================================
# RENDER SERVICE  (render-service/.env)
# =============================================================================

PORT=3000                                   # [OPTIONAL] Default: 3000
HOST=0.0.0.0                               # [OPTIONAL]

# API key required on POST /fetch.  Leave blank to disable auth (trusted network only).
API_KEY=                                    # [OPTIONAL]

# Browser recycling
HEADLESS=true                               # [OPTIONAL]
BROWSER_MAX_PAGES=500                       # [OPTIONAL] Recycle after N pages
BROWSER_MAX_AGE_MS=14400000                 # [OPTIONAL] Recycle after 4h

# Concurrency
MAX_CONCURRENCY=5                           # [OPTIONAL]
MAX_QUEUE_SIZE=200                          # [OPTIONAL]

# Timeouts (milliseconds)
NAVIGATION_TIMEOUT_MS=30000                 # [OPTIONAL]
NETWORK_IDLE_TIMEOUT_MS=8000                # [OPTIONAL]
RENDER_EXTRA_WAIT_MS=500                    # [OPTIONAL]
REQUEST_TIMEOUT_MS=60000                    # [OPTIONAL] Overall per-request budget
QUEUE_WAIT_TIMEOUT_MS=45000                 # [OPTIONAL]

# Retry / exponential backoff
MAX_RETRIES=3                               # [OPTIONAL]
RETRY_BASE_DELAY_MS=1000                    # [OPTIONAL]
RETRY_MAX_DELAY_MS=10000                    # [OPTIONAL]

# Cloudflare challenge handling
CLOUDFLARE_MAX_WAIT_MS=15000                # [OPTIONAL]
CLOUDFLARE_POLL_INTERVAL_MS=1000            # [OPTIONAL]

# Security — block SSRF to internal network addresses
BLOCK_PRIVATE_NETWORK_TARGETS=true          # [OPTIONAL]

# Misc
LOG_LEVEL=info                              # [OPTIONAL]
SHUTDOWN_TIMEOUT_MS=15000                   # [OPTIONAL]


# =============================================================================
# DATA PLANE  (data/.env)
# =============================================================================

# --- PostgreSQL ---
# Standard libpq environment variable names are used throughout for
# compatibility with psql, pg_dump, and other tooling.
PGHOST=localhost                            # [OPTIONAL] Default: localhost
PGPORT=5432                                 # [OPTIONAL] Default: 5432
PGDATABASE=opportunity_radar               # [OPTIONAL] Default: opportunity_radar
PGUSER=postgres                             # [OPTIONAL] Default: postgres
PGPASSWORD=postgres                         # [REQUIRED in production]
PGSSL=false                                 # [OPTIONAL] Set true for TLS connections

# Connection pool
PG_POOL_MAX=10                              # [OPTIONAL] Max pool connections
PG_IDLE_TIMEOUT_MS=30000                    # [OPTIONAL] Idle connection timeout
PG_CONNECT_TIMEOUT_MS=5000                  # [OPTIONAL] Connection acquisition timeout

# --- Redis ---
REDIS_HOST=localhost                        # [OPTIONAL] Default: localhost
REDIS_PORT=6379                             # [OPTIONAL] Default: 6379
REDIS_PASSWORD=                             # [OPTIONAL] Leave blank for no auth (local dev)
REDIS_DB=0                                  # [OPTIONAL] Logical database index (0–15)

# --- Embedding Model ---
# EMBEDDING_DIM must match the model's actual output dimension exactly.
# The schema uses this value to size the vector columns in PostgreSQL.
# Changing this after initial migration requires a new ALTER TABLE migration.
#
#   text-embedding-3-small  → 1536  (OpenAI, cost-efficient, recommended)
#   text-embedding-3-large  → 3072  (OpenAI, higher quality)
#   text-embedding-ada-002  → 1536  (OpenAI, legacy)
#   nomic-embed-text        → 768   (open-source alternative)
#
EMBEDDING_DIM=1536                          # [OPTIONAL] Default: 1536
EMBEDDING_MODEL=text-embedding-3-small      # [OPTIONAL] Informational; used in logs

# Search Planner
TAVILY_API_KEY=                             # [REQUIRED]
