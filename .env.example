# =============================================================================
# Opportunity Radar — Master Environment Variable Reference
# =============================================================================
#
# This file documents EVERY environment variable used across ALL services.
# It is the single authoritative reference for configuration.
#
# USAGE:
#   - Copy the relevant section to each service's own .env file.
#   - Never commit real secrets. This file contains only documented placeholders.
#   - Variables marked [REQUIRED] have no safe default and must be set.
#   - Variables marked [OPTIONAL] have safe defaults noted inline.
#
# =============================================================================


# =============================================================================
# AI GATEWAY  (ai-gateway/.env)
# =============================================================================

# HTTP server
PORT=4000                                   # [OPTIONAL] Default: 4000

# Auth — shared secret that all callers must supply as X-Api-Key header
GATEWAY_API_KEY=                            # [REQUIRED]

# Timeouts (milliseconds)
GLOBAL_TIMEOUT_MS=120000                    # [OPTIONAL] Per-request wall-clock budget (code default: 120000)
PROVIDER_TIMEOUT_MS=60000                   # [OPTIONAL] Per-provider call budget (code default: 60000)
MAX_PROVIDER_RETRIES=3                      # [OPTIONAL] Retries per provider (0–5). Backoff is
                                            # 2.5s*2^n, sized to outlast Groq's per-minute token window.

# Google Gemini
GEMINI_API_KEY=                             # [REQUIRED]
GEMINI_MODEL=gemini-flash-latest            # [OPTIONAL] Use the ALIAS, not a pinned version:
                                            # pinned models get retired and start returning 404
                                            # (gemini-2.5-flash already does).

# OpenRouter (OpenAI-compatible proxy)
OPENROUTER_API_KEY=                         # [REQUIRED]
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free  # [OPTIONAL] Free tier; slower than Groq but
                                            # useful as the last fallback.

# Groq (OpenAI-compatible)
GROQ_API_KEY=                               # [REQUIRED]
GROQ_MODEL=llama-3.3-70b-versatile          # [OPTIONAL]


# =============================================================================
# RENDER SERVICE  (render-service/.env)
# =============================================================================

PORT=3100                                   # [OPTIONAL] Default: 3100. NOT 3000 —
                                            # that port is commonly taken by other local apps.
HOST=0.0.0.0                               # [OPTIONAL]

# API key required on POST /fetch.  Leave blank to disable auth (trusted network only).
API_KEY=                                    # [OPTIONAL]

# Browser recycling
HEADLESS=true                               # [OPTIONAL]
BROWSER_MAX_PAGES=500                       # [OPTIONAL] Recycle after N pages
BROWSER_MAX_AGE_MS=14400000                 # [OPTIONAL] Recycle after 4h

# Concurrency
MAX_CONCURRENCY=5                           # [OPTIONAL]
MAX_QUEUE_SIZE=200                          # [OPTIONAL]

# Timeouts (milliseconds)
NAVIGATION_TIMEOUT_MS=30000                 # [OPTIONAL]
NETWORK_IDLE_TIMEOUT_MS=8000                # [OPTIONAL]
RENDER_EXTRA_WAIT_MS=500                    # [OPTIONAL]
REQUEST_TIMEOUT_MS=60000                    # [OPTIONAL] Overall per-request budget
QUEUE_WAIT_TIMEOUT_MS=45000                 # [OPTIONAL]

# Retry / exponential backoff
MAX_RETRIES=3                               # [OPTIONAL]
RETRY_BASE_DELAY_MS=1000                    # [OPTIONAL]
RETRY_MAX_DELAY_MS=10000                    # [OPTIONAL]

# Cloudflare challenge handling
CLOUDFLARE_MAX_WAIT_MS=15000                # [OPTIONAL]
CLOUDFLARE_POLL_INTERVAL_MS=1000            # [OPTIONAL]

# Security — block SSRF to internal network addresses
BLOCK_PRIVATE_NETWORK_TARGETS=true          # [OPTIONAL]

# Misc
LOG_LEVEL=info                              # [OPTIONAL]
SHUTDOWN_TIMEOUT_MS=15000                   # [OPTIONAL]


# =============================================================================
# DATA PLANE  (data/.env)
# =============================================================================

# --- PostgreSQL ---
# Standard libpq environment variable names are used throughout for
# compatibility with psql, pg_dump, and other tooling.
PGHOST=localhost                            # [OPTIONAL] Default: localhost
PGPORT=5432                                 # [OPTIONAL] Default: 5432
PGDATABASE=opportunity_radar               # [OPTIONAL] Default: opportunity_radar
PGUSER=postgres                             # [OPTIONAL] Default: postgres
PGPASSWORD=postgres                         # [REQUIRED in production]
PGSSL=false                                 # [OPTIONAL] Set true for TLS connections

# Connection pool
PG_POOL_MAX=10                              # [OPTIONAL] Max pool connections
PG_IDLE_TIMEOUT_MS=30000                    # [OPTIONAL] Idle connection timeout
PG_CONNECT_TIMEOUT_MS=5000                  # [OPTIONAL] Connection acquisition timeout

# --- Redis ---
REDIS_HOST=localhost                        # [OPTIONAL] Default: localhost
REDIS_PORT=6379                             # [OPTIONAL] Default: 6379
REDIS_PASSWORD=                             # [OPTIONAL] Leave blank for no auth (local dev)
REDIS_DB=0                                  # [OPTIONAL] Logical database index (0–15)

# --- Embedding Model ---
# EMBEDDING_DIM must match the model's actual output dimension exactly.
# The schema uses this value to size the vector columns in PostgreSQL.
# Changing this after initial migration requires a new ALTER TABLE migration.
#
#   text-embedding-3-small  → 1536  (OpenAI, cost-efficient, recommended)
#   text-embedding-3-large  → 3072  (OpenAI, higher quality)
#   text-embedding-ada-002  → 1536  (OpenAI, legacy)
#   nomic-embed-text        → 768   (open-source alternative)
#
EMBEDDING_DIM=1536                          # [OPTIONAL] Default: 1536
EMBEDDING_MODEL=text-embedding-3-small      # [OPTIONAL] Informational; used in logs

# Search Planner
TAVILY_API_KEY=                             # [REQUIRED]


# =============================================================================
# SEARCH PLANNER  (search-planner/.env)
# =============================================================================
# Reads the same PG* variables as the Data Plane above.
# NOTE: /search-plan/build writes to search_plans, whose candidate_id is a
# foreign key into candidates(id). The stateless pipeline uses
# /search-plan/preview instead, which needs no database row.

SP_MAX_QUERIES_PER_TIER=5                   # [OPTIONAL]
SP_MAX_TOTAL_QUERIES=20                     # [OPTIONAL]
SP_PLAN_VERSION=1.0.0                       # [OPTIONAL]
SP_FRESHNESS_T1=24h                         # [OPTIONAL]
SP_FRESHNESS_T2=48h                         # [OPTIONAL]
SP_FRESHNESS_T3=72h                         # [OPTIONAL]
SP_FRESHNESS_T4=48h                         # [OPTIONAL]


# =============================================================================
# JOB SERVER  (job-server/.env)
# =============================================================================
# Reads the same PG* variables as the Data Plane above.

JOB_SERVER_PORT=4300                        # [OPTIONAL] Default: 4300

# CORS is OFF by default and should stay off: Opportunity Radar's backend
# proxies this service, the browser never calls it directly.
ENABLE_CORS=false                           # [OPTIONAL]
CORS_ORIGIN=                                # [REQUIRED only when ENABLE_CORS=true]

MAX_UPLOAD_BYTES=5242880                    # [OPTIONAL] 5 MB
JOB_STUCK_AFTER_MS=1800000                  # [OPTIONAL] 30 min before a running job is swept
SWEEP_INTERVAL_MS=60000                     # [OPTIONAL] Sweep runs on this interval, not only at startup
UPLOAD_DIR=/tmp/opportunity-radar-uploads   # [OPTIONAL]

# Set to a JSON file path to run the job server against a CAPTURED pipeline
# response instead of invoking n8n. Used by the job-server test suite so the
# HTTP surface can be exercised with zero API calls. Leave unset in production.
STUB_PIPELINE=                              # [OPTIONAL]


# =============================================================================
# REPOSITORY ROOT  (./.env)  — read by n8n itself
# =============================================================================
# n8n Code/HTTP nodes reference these as $env.NAME. Both are REQUIRED for the
# workflow to run; GATEWAY_API_KEY must match the value in ai-gateway/.env.

GATEWAY_API_KEY=                            # [REQUIRED] Must equal ai-gateway/.env
TAVILY_API_KEY=                             # [REQUIRED] Search provider

# Where the workflow reads the resume PDF from. The job server writes each
# uploaded PDF here before invoking n8n, so both must agree. Any absolute path
# works; the directory is created automatically.
RESUME_INPUT_PATH=/home/YOU/.n8n-files/resume-input.pdf   # [REQUIRED]

# render-service validates its OWN API_KEY (render-service/.env), which is a
# DIFFERENT secret from GATEWAY_API_KEY. Sending the gateway key to
# render-service returns 401 and silently yields empty pages for every
# JS-heavy site — the single most damaging failure mode this system has had,
# because nothing downstream errors: pages just come back blank.
RENDER_SERVICE_API_KEY=                     # [REQUIRED] Must equal render-service/.env API_KEY
RENDER_SERVICE_URL=http://127.0.0.1:3100    # [OPTIONAL] Renderer health/fetch base URL
