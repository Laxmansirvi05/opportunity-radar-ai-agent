# =============================================================================
# profile-builder — Environment Variables
# Copy to .env and fill in values before running locally.
# =============================================================================

# --- AI Gateway ---
# Base URL of the running AI Gateway service.
GATEWAY_BASE_URL=http://localhost:4000

# API key that matches GATEWAY_API_KEY in ai-gateway/.env
GATEWAY_API_KEY=replace-with-a-strong-random-secret

# --- PostgreSQL (must match data/.env) ---
# profile-builder loads the shared data/src/db.js which reads these vars.
PGHOST=/tmp
PGPORT=5432
PGDATABASE=opportunity_radar
PGUSER=postgres
PGPASSWORD=
PGSSL=false

# Connection pool tuning
PG_POOL_MAX=5
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECT_TIMEOUT_MS=5000

# --- Embedding Model (used by data/src/config.js; deferred to Sprint 3) ---
EMBEDDING_DIM=1536
EMBEDDING_MODEL=text-embedding-3-small

# --- Redis (used by data/src/config.js; deferred to Sprint 3) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
