    "\\.ga$"
  ],

  "description_completeness": {
    "_doc": "Minimum fields expected in a well-formed listing. Missing fields reduce trust but don't auto-exclude.",
    "required_signals": ["title", "company", "description"],
    "quality_signals": ["location", "requirements", "skills", "apply_url", "employment_type"]
  }
