# =============================================================================
# Data Plane — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values for your environment.
# All values shown are defaults that match the docker-compose.yml dev setup.
# =============================================================================

# --- PostgreSQL ---
PGHOST=localhost
PGPORT=5432
PGDATABASE=opportunity_radar
PGUSER=postgres
PGPASSWORD=postgres
PGSSL=false                                 # [OPTIONAL] false=no TLS | require=TLS no cert verify | true=TLS full verify (production)

# Connection pool tuning
PG_POOL_MAX=10
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECT_TIMEOUT_MS=5000

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# --- Embedding Model ---
# MUST match the output dimension of the embedding model in use.
# Changing this after initial migration requires a new ALTER TABLE migration.
#   text-embedding-3-small  → 1536
#   text-embedding-3-large  → 3072
#   nomic-embed-text        → 768
EMBEDDING_DIM=1536
EMBEDDING_MODEL=text-embedding-3-small
